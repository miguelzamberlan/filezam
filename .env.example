# ---- Host mapping (used by docker-compose.yml) ----
# UID/GID that owns the data folder on the host (run `id -u` and `id -g`).
# Nunca use PUID=0: anula a execução sem root do container.
PUID=1000
PGID=1000
# Host folder exposed by the file manager (mounted at /data in the container).
FILEZAM_HOST_ROOT=./data
# Host folder for the database (mounted at /config). Keep it outside FILEZAM_HOST_ROOT.
FILEZAM_HOST_CONFIG=./config
# Address/port published on the host. 127.0.0.1 = only a proxy on this server reaches it;
# 0.0.0.0 = also reachable from your LAN (clients keep their real IP; see docs/08, "Porta local").
FILEZAM_BIND=127.0.0.1
FILEZAM_PORT=8080
# Subnet of the compose network. Its gateway (.1) is where connections from the host come from.
FILEZAM_SUBNET=172.31.250.0/24
# Version string baked into the image (docker compose build); `git describe` output is a good value.
FILEZAM_VERSION=dev

# ---- Application ----
# Exact IPs (or CIDRs) of your reverse proxy: only these may set X-Forwarded-For/Proto/Host.
# Whoever connects from a trusted address picks the IP used for the audit log, login rate limits
# and lockout, so trust as little as possible:
#   proxy on this server (Caddy/nginx) -> the compose gateway, 172.31.250.1 (default below)
#   no proxy, LAN only                 -> leave empty
#   proxy in a container (Traefik, cloudflared) -> that container's fixed IP
# Never trust LAN ranges (192.168.0.0/16) or 0.0.0.0/0. Details: docs/08, "Porta local e proxies".
FILEZAM_TRUSTED_PROXIES=172.31.250.1
# true = always Secure cookies (HTTPS via proxy); false = plain HTTP (local only); auto = detect via X-Forwarded-Proto.
FILEZAM_SECURE_COOKIES=true
# Public base URL used to build share links, e.g. https://files.example.com (optional).
FILEZAM_PUBLIC_URL=
# Initial admin account (only used on the very first start; password change is forced at first login).
FILEZAM_ADMIN_USER=admin
FILEZAM_ADMIN_PASSWORD=admin
# Session lifetime (sliding), max 30 days absolute.
FILEZAM_SESSION_TTL=168h
# Upload chunk size (1MiB-1GiB). Keep <= 64MiB behind Cloudflare.
FILEZAM_MAX_UPLOAD_CHUNK=16MiB
# Space one user's unfinished chunked uploads may reserve (pre-allocated on disk). 0 = no cap.
FILEZAM_UPLOAD_MAX_RESERVED=100GiB
# Maximum lifetime of a public share link.
FILEZAM_SHARE_MAX_TTL=720h
# fsync uploaded files before finalizing (safer; set false for max throughput on slow disks).
FILEZAM_FSYNC=true
# debug | info | warn | error
FILEZAM_LOG_LEVEL=info
# Days deleted items stay in the trash before permanent removal (0 disables the trash).
FILEZAM_TRASH_RETENTION=720h
# Full rescan interval of the search name index (0 disables the index; search then walks the disk).
FILEZAM_INDEX_INTERVAL=6h
# Enables GET /metrics (Prometheus) for clients sending `Authorization: Bearer <token>`. Empty = disabled.
FILEZAM_METRICS_TOKEN=
# 64 hex chars (32 bytes) encrypting 2FA secrets; empty = /config/secret.key generated on first start. Back it up with the DB.
FILEZAM_SECRET_KEY=
# true forces administrators to enable two-factor authentication before using the app.
FILEZAM_REQUIRE_2FA_ADMINS=false
